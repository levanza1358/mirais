# =============================================
# xAI (Grok) Farm Configuration
# =============================================

# Gmail IMAP (untuk membaca email OTP dari x.ai)
# Akun Gmail ASLI yang menerima forwarding dari levanza.my.id
GMAIL_USERNAME=your_gmail@gmail.com

# App Password dari Google Account (bukan password Gmail biasa)
# Cara buat: Google Account → Security → 2-Step Verification → App passwords
# Pilih "Mail" dan device, lalu copy 16 karakter password
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Domain email untuk akun yang di-farm
EMAIL_DOMAIN=levanza.my.id

# Password untuk akun xAI yang dibuat
ACCOUNT_PASSWORD=XaiFarm2024!

# Browser mode (true = headless, false = visible browser)
HEADLESS=false

# OTP polling settings
DELAY_OTP_CHECK=5
MAX_OTP_RETRIES=12
