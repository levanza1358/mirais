# =============================================
# xAI (Grok) Farm Configuration
# =============================================

# Gmail IMAP (used to read the OTP email from x.ai)
# The real Gmail account that receives forwarded mail from your catch-all domain
GMAIL_USERNAME=your_gmail@gmail.com

# App Password from your Google Account (not your regular Gmail password)
# How to create: Google Account → Security → 2-Step Verification → App passwords
# Pick "Mail" and a device, then copy the 16-character password
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Email domain used for farmed accounts
EMAIL_DOMAIN=example.com

# Password assigned to the xAI accounts that get created
ACCOUNT_PASSWORD=XaiFarm2024!

# Browser mode (true = headless, false = visible browser)
HEADLESS=false

# OTP polling settings
DELAY_OTP_CHECK=5
MAX_OTP_RETRIES=12
