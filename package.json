{
  "name": "mirais",
  "version": "1.0.0",
  "description": "Self-hosted AI gateway & router — one local endpoint for all your LLM providers",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "bun --watch src/server.ts",
    "dev:dashboard": "bun --cwd dashboard run dev",
    "build": "bun run scripts/build-dashboard.ts",
    "start": "bun run src/server.ts",
    "typecheck": "bun x tsc --noEmit -p .",
    "test": "bun test test/",
    "smoke": "bun run scripts/smoke.ts",
    "backup": "bun run scripts/backup.ts",
    "mirais": "bun run scripts/cli.ts",
    "svc:start": "bun run scripts/cli.ts start",
    "svc:stop": "bun run scripts/cli.ts stop",
    "svc:restart": "bun run scripts/cli.ts restart",
    "svc:status": "bun run scripts/cli.ts status"
  },
  "dependencies": {
    "elysia": "^1.2.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "bun-types": "^1.3.14",
    "typescript": "^5.7.0"
  }
}
