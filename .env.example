# ── Server ──
PORT=1463
HOST=127.0.0.1
DATA_DIR=./data

# ── Dashboard auth ──
# Leave DASHBOARD_PASSWORD empty to get the first-run setup screen
DASHBOARD_PASSWORD=
SESSION_SECRET=
SESSION_TTL_HOURS=12

# ── Behaviour ──
TOKEN_SAVER=on
TRACK_PAYLOADS=meta
REQUEST_BODY_LIMIT_MB=25
UPSTREAM_TIMEOUT_MS=120000
LOG_LEVEL=info

# ── Proxy (corp machines) ──
# HTTPS_PROXY=http://proxy:8080
