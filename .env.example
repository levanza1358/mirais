# ── Server ──
PORT=1463
# For public deployments, prefer 127.0.0.1 behind an authenticated reverse
# proxy. Mirais itself intentionally has no dashboard password.
HOST=127.0.0.1
DATA_DIR=./data

# ── Behaviour ──
TOKEN_SAVER=on
TRACK_PAYLOADS=meta
REQUEST_BODY_LIMIT_MB=25
UPSTREAM_TIMEOUT_MS=120000
LOG_LEVEL=info

# ── Proxy (corp machines) ──
# HTTPS_PROXY=http://proxy:8080