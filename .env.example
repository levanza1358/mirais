# ── Server ──
PORT=1463
# Bind to loopback so the passwordless dashboard mode can be enabled.
# Switch to 0.0.0.0 only when you set DASHBOARD_PASSWORD below.
HOST=127.0.0.1
DATA_DIR=./data

# ── Dashboard auth ──
# Leave DASHBOARD_PASSWORD empty for passwordless dashboard mode
# (allowed only when HOST is loopback; the server will refuse to start
# otherwise). To require a password again, set it to a non-empty value.
DASHBOARD_PASSWORD=
SESSION_SECRET=
SESSION_TTL_HOURS=12

# ── Behaviour ──
TOKEN_SAVER=on
TRACK_PAYLOADS=meta
REQUEST_BODY_LIMIT_MB=25
UPSTREAM_TIMEOUT_MS=120000
LOG_LEVEL=info

# ── Proxy (corp machines) ──
# HTTPS_PROXY=http://proxy:8080