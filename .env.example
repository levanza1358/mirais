# ── Server ──
PORT=1463
# For public deployments, prefer 127.0.0.1 behind an authenticated reverse
# proxy. The dashboard password below is optional and never replaces
# network-level access control.
HOST=127.0.0.1
DATA_DIR=./data

# ── Dashboard auth ──
# The dashboard password is ON by default (12345678 until you change it in
# Settings → General). Set this to preset a different initial password on a
# fresh install. It guards the dashboard only — /v1/* clients use gateway keys.
# DASHBOARD_PASSWORD=change-me
SESSION_TTL_HOURS=12            # default login lifetime; configurable in Settings

# ── Behaviour ──
TOKEN_SAVER=on
TRACK_PAYLOADS=meta
REQUEST_BODY_LIMIT_MB=25
# Server-level cap for file uploads (backup restore). Bun rejects larger
# request bodies with 413 before any route runs.
MAX_UPLOAD_MB=1024
UPSTREAM_TIMEOUT_MS=120000
LOG_LEVEL=info

# ── Gateway auth ──
# MIRAIS_AUTH_REQUIRED=on (default) requires every /v1/* request to carry
# `Authorization: Bearer <key>`. Set MIRAIS_AUTH_REQUIRED=off to allow anonymous
# proxy use (only safe when Mirais is bound to 127.0.0.1 / a trusted network).
# The escape-hatch placeholder "anonymous" is also accepted in that mode.
MIRAIS_AUTH_REQUIRED=on

# ── Proxy (corp machines) ──
# HTTPS_PROXY=http://proxy:8080